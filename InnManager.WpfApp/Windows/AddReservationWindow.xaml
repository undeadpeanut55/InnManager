<Window x:Class="InnManager.WpfApp.Windows.AddReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InnManager.WpfApp.Windows"
        xmlns:enum="clr-namespace:InnManager.Enums;assembly=InnManager"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="AddReservationWindow" Height="450" Width="450">

    <!--
    <Window.Resources>
        <ObjectDataProvider x:Key="statusTypes" MethodName="GetValues" ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enum:RoomStatus"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="statuses" MethodName="GetValues" ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enum:RoomStatus"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
-->

    <DockPanel>
        <TextBlock Text="New Reservation" FontWeight="Bold" FontSize="25" Background="Azure" DockPanel.Dock="Top"/>
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right">
            <Button Content="Create Reservation"/>
            <Button Content="Cancel"/>
        </WrapPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="Guest" Grid.Column="0" Grid.Row="0"/>
            <ComboBox x:Name="GuestInput" ItemsSource="{Binding Guests}" Grid.Column="1" Grid.Row="0"/>

            <TextBlock Text="Room" Grid.Column="0" Grid.Row="1"/>
            <ComboBox x:Name="RoomInput" ItemsSource="{Binding Rooms}" Grid.Column="1" Grid.Row="1"/>

            <TextBlock Text="Check-In Date" Grid.Column="0" Grid.Row="2"/>
            <DatePicker x:Name="CheckInDateInput" Grid.Column="1" Grid.Row="2"/>
            
            <TextBlock Text="Check-Out Date" Grid.Column="0" Grid.Row="3"/>
            <DatePicker x:Name="CheckOutDateInput" Grid.Column="1" Grid.Row="3"/>

            <TextBlock Text="Number of Guests" Grid.Column="0" Grid.Row="4"/>
            <Grid Grid.Column="1" Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBox x:Name="NumberOfGuestsInput" VerticalAlignment="Center" Grid.Column="0" Grid.RowSpan="2" Text="0"/>
                <Button Grid.Column="1" Grid.Row="0" Content="+"/>
                <Button Grid.Column="1" Grid.Row="1" Content="-"/>
            </Grid>

            <TextBlock Text="Status"  Grid.Column="0" Grid.Row="5"/>
            <ComboBox x:Name="StatusInput" Grid.Column="1" Grid.Row="5"/>
        </Grid>
        
    </DockPanel>
</Window>
