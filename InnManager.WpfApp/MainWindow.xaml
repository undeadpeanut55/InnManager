<Window x:Class="InnManager.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InnManager.WpfApp" 
        xmlns:local1="clr-namespace:InnManager.WpfApp.Controls"
        mc:Ignorable="d"
        Title="InnManager" Height="720" Width="1080">

    <DockPanel>
        <Grid Name="ApplicationHeader" Height="80" DockPanel.Dock="Top" Background="LightBlue">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="InnManager" FontSize="35" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="Hotel Management System" FontSize="25" FontWeight="Bold"/>

        </Grid>
        
        
        <StackPanel Background="LightPink" Width="200" DockPanel.Dock="Left" Name="Sidebar">

            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Margin" Value="4"/>
                    <Setter Property="Height" Value="48"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="20"/>
                </Style>
            </StackPanel.Resources>
            
            <Button Content="Dashboard"/>
            <Button Content="Rooms"/>
            <Button Content="Reservations"/>
            <Button Content="Guests"/>
            <Button Content="Services"/>
            <Button Content="Invoices"/>
            <Button Content="Payments"/>
            <Button Content="Employees"/>
            <Button Content="Housekeeping"/>
            <Button Content="Reports"/>
            <Button Content="Settings"/>

        </StackPanel>
        
        <Grid Background="CornflowerBlue" Name="MainContentArea">
            <local1:DashboardControl/>
        </Grid>
        
    </DockPanel>
    
</Window>
