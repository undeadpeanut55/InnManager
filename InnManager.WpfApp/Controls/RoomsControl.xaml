<UserControl x:Class="InnManager.WpfApp.Controls.RoomsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="640" d:DesignWidth="880">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Rooms" FontSize="35" FontWeight="Bold" Background="Azure" Grid.Row="0" Grid.ColumnSpan="2"/>
        
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Background="Linen">
            <WrapPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="Margin" Value="10"/>
                    <Setter Property="Height" Value="25"/>
                </Style>
            </WrapPanel.Resources>
            <Button Click="HandleAddRoomClick" Content="Add Room"/>
            <Button Content="Edit"/>
            <Button Content="Delete"/>
            <Button Content="Refresh"/>

        </WrapPanel>

        <TextBox Height="25" FontSize="15" Grid.Row="1" Grid.Column="1" Width="200" Text="Search room number... "/>

        <Grid Grid.ColumnSpan="2" Grid.Row="2" Background="LightBlue">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="25"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Room Number"/>
            <TextBlock Text="Room Type" Grid.Column="1"/>
            <TextBlock Text="Floor" Grid.Column="2"/>
            <TextBlock Text="Capacity" Grid.Column="3"/>
            <TextBlock Text="Rate ($)" Grid.Column="4"/>
            <TextBlock Text="Status" Grid.Column="5"/>
            <TextBlock Text="Is Clean" Grid.Column="6"/>
            <TextBlock Text="Has Balcony" Grid.Column="7"/>

            <DataGrid HeadersVisibility="None" Grid.ColumnSpan="8" Grid.Row="1" ItemsSource="{Binding Path=Rooms}" AutoGenerateColumns="False" IsReadOnly="true">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*" Binding="{Binding RoomNumber}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding RoomType}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding Floor}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding Capacity}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding NightlyRate}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding Status}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding IsClean}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding HasBalcony}"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.ColumnSpan="8" Grid.Row="2">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}Total Rooms: {0}">
                        <Binding Path="Rooms.Count"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

        </Grid>
        
    </Grid>
</UserControl>
