<Window x:Class="InnManager.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InnManager.WpfApp" 
        xmlns:local1="clr-namespace:InnManager.WpfApp.Controls"
        mc:Ignorable="d"
        Title="InnManager" Height="720" Width="1080" MinHeight="720" MinWidth="1080">

    <DockPanel>
        <Grid Name="ApplicationHeader" Height="80" DockPanel.Dock="Top" Background="LightBlue">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="InnManager" FontSize="35" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="Hotel Management System" FontSize="25" FontWeight="Bold"/>

        </Grid>
        
        
        <StackPanel Background="LightPink" Width="200" DockPanel.Dock="Left" Name="Sidebar">

            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Margin" Value="4"/>
                    <Setter Property="Height" Value="45"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="20"/>
                </Style>
            </StackPanel.Resources>
            
            <Button Click="HandleSwitchToDashboard" Content="Dashboard"/>
            <Button Click="HandleSwitchToRooms" Content="Rooms"/>
            <Button Click="HandleSwitchToReservations" Content="Reservations"/>
            <Button Click="HandleSwitchToGuests" Content="Guests"/>
            <Button Click="HandleSwitchToServices" Content="Services"/>
            <Button Click="HandleSwitchToInvoices" Content="Invoices"/>
            <Button Click="HandleSwitchToPayments" Content="Payments"/>
            <Button Click="HandleSwitchToEmployees" Content="Employees"/>
            <Button Click="HandleSwitchToHousekeeping" Content="Housekeeping"/>
            <Button Click="HandleSwitchToReports" Content="Reports"/>
            <Button Click="HandleSwitchToSettings" Content="Settings"/>

        </StackPanel>
        
        <Grid Background="CornflowerBlue" Name="MainContentArea">
            <local1:DashboardControl x:Name="DashboardDisplay" Visibility="Visible"/>
            <local1:EmployeesControl x:Name="EmployeesDisplay" Visibility="Hidden"/>
            <local1:GuestsControl x:Name="GuestsDisplay" Visibility="Hidden"/>
            <local1:HousekeepingControl x:Name="HousekeepingDisplay" Visibility="Hidden"/>
            <local1:InvoicesControl x:Name="InvoicesDisplay" Visibility="Hidden"/>
            <local1:PaymentsControls x:Name="PaymentsDisplay" Visibility="Hidden"/>
            <local1:ReportsControl x:Name="ReportsDisplay" Visibility="Hidden"/>
            <local1:ReservationsControl x:Name="ReservationsDisplay" Visibility="Hidden"/>
            <local1:RoomsControl x:Name="RoomsDisplay" Visibility="Hidden"/>
            <local1:ServicesControl x:Name="ServicesDisplay" Visibility="Hidden"/>
            <local1:SettingsControl x:Name="SettingsDisplay" Visibility="Hidden"/>
        </Grid>
        
    </DockPanel>
    
</Window>
