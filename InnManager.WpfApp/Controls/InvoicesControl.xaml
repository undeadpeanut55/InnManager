<UserControl x:Class="InnManager.WpfApp.Controls.InvoicesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="640" d:DesignWidth="880">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Invoices" FontSize="35" FontWeight="Bold" Background="LightBlue" Grid.Row="0" Grid.ColumnSpan="2"/>

        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Background="Linen">
            <WrapPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="Margin" Value="10"/>
                    <Setter Property="Height" Value="25"/>
                </Style>
            </WrapPanel.Resources>
            <Button Content="+ New Invoice"/>
            <Button Content="View"/>
            <Button Content="Download"/>
            <Button Content="Refresh"/>

        </WrapPanel>

        <TextBox Height="25" FontSize="15" Grid.Row="1" Grid.Column="1" Width="380" Text="Search invoice number, guest name or room number... "/>

        <Grid Grid.ColumnSpan="2" Grid.Row="2" Background="LightBlue">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="25"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Invoice #"/>
            <TextBlock Text="Guest Name" Grid.Column="1"/>
            <TextBlock Text="Room Number" Grid.Column="2"/>
            <TextBlock Text="Invoice Date" Grid.Column="3"/>
            <TextBlock Text="Due Date" Grid.Column="4"/>
            <TextBlock Text="Total Amount ($)" Grid.Column="5"/>
            <TextBlock Text="Paid Amount ($)" Grid.Column="6"/>
            <TextBlock Text="Status" Grid.Column="7"/>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="8">

            </StackPanel>

            <TextBlock Grid.ColumnSpan="8" Grid.Row="2" Text="Total Invoices: 0"/>

        </Grid>

    </Grid>

</UserControl>
