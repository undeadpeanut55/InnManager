<UserControl x:Class="InnManager.WpfApp.Controls.PaymentsControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="640" d:DesignWidth="880">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Payments" FontSize="35" FontWeight="Bold" Background="LightBlue" Grid.Row="0" Grid.ColumnSpan="2"/>

        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Background="Linen">
            <WrapPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="Margin" Value="10"/>
                    <Setter Property="Height" Value="25"/>
                </Style>
            </WrapPanel.Resources>
            <Button Click="HandleNewPaymentClick" Content="+ New Payment"/>
            <Button Content="View"/>
            <Button Content="Receipt"/>
            <Button Content="Refund"/>
            <Button Content="Refresh"/>

        </WrapPanel>

        <TextBox Height="25" FontSize="15" Grid.Row="1" Grid.Column="1" Width="360" Text="Search invoice number, guest name, or reference... "/>

        <Grid Grid.ColumnSpan="2" Grid.Row="2" Background="LightBlue">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="25"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Invoice Number"/>
            <TextBlock Text="Guest Name" Grid.Column="1"/>
            <TextBlock Text="Payment Date" Grid.Column="2"/>
            <TextBlock Text="Payment Method" Grid.Column="3"/>
            <TextBlock Text="Amount ($)" Grid.Column="4"/>
            <TextBlock Text="Status" Grid.Column="5"/>
            <TextBlock Text="Reference No" Grid.Column="6"/>

            <DataGrid IsReadOnly="True" ItemsSource="{Binding Payments}" AutoGenerateColumns="False" HeadersVisibility="None" Grid.Row="1" Grid.ColumnSpan="7">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*" Binding="{Binding ReferenceNumber}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding ReferenceNumber}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding Date}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding PaymentMethod}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding Amount}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding Status}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding ReferenceNumber}"/>
                </DataGrid.Columns>

            </DataGrid>

            <TextBlock Grid.ColumnSpan="8" Grid.Row="2" Text="Total Payments: 0"/>

        </Grid>

    </Grid>

</UserControl>
