<UserControl x:Class="InnManager.WpfApp.Controls.ReservationsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="640" d:DesignWidth="880">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Reservations" FontSize="35" FontWeight="Bold" Background="Azure" Grid.Row="0" Grid.ColumnSpan="2"/>

        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Background="Linen">
            <WrapPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="Margin" Value="10"/>
                    <Setter Property="Height" Value="25"/>
                </Style>
            </WrapPanel.Resources>
            <Button Click="HandleAddReservationClick" Content="New Reservation"/>
            <Button Content="Edit"/>
            <Button Content="Cancel"/>
            <Button Content="Refresh"/>
        </WrapPanel>

        <TextBox Height="25" FontSize="15" Grid.Row="1" Grid.Column="1"  Width="300" Text="Search guest name, reservation number... "/>

        <Grid Grid.ColumnSpan="2" Grid.Row="2" Background="LightBlue">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="25"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Reservation #"/>
            <TextBlock Text="Guest Name" Grid.Column="1"/>
            <TextBlock Text="Room" Grid.Column="2"/>
            <TextBlock Text="Check-In" Grid.Column="3"/>
            <TextBlock Text="Check-Out" Grid.Column="4"/>
            <TextBlock Text="Status" Grid.Column="5"/>
            <TextBlock Text="Total Amount" Grid.Column="6"/>

            <DataGrid HeadersVisibility="None" ItemsSource="{Binding Path=Reservations}" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="1" Grid.ColumnSpan="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*" Binding="{Binding ReservationNumber}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding GuestName}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding RoomNumber}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding CheckInDate}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding CheckOutDate}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding Status}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding TotalAmount}"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.ColumnSpan="8" Grid.Row="2" Text="Total Reservations: 0"/>

        </Grid>

    </Grid>
</UserControl>
