<UserControl x:Class="InnManager.WpfApp.Controls.GuestsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="640" d:DesignWidth="880">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Guests" FontSize="35" FontWeight="Bold" Background="Azure" Grid.Row="0" Grid.ColumnSpan="2"/>

        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Background="Linen">
            <WrapPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="Margin" Value="10"/>
                    <Setter Property="Height" Value="25"/>
                </Style>
            </WrapPanel.Resources>
            <Button Click="HandleAddGuestClick" Content="Add Guest"/>
            <Button Content="Edit"/>
            <Button Content="Delete"/>
            <Button Content="Refresh"/>

        </WrapPanel>

        <TextBox Height="25" FontSize="15" Grid.Row="1" Grid.Column="1" Width="300" Text="Search guest by name, phone, or email... "/>

        <Grid Grid.ColumnSpan="2" Grid.Row="2" Background="LightBlue">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="25"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Guest ID"/>
            <TextBlock Text="First Name" Grid.Column="1"/>
            <TextBlock Text="Last Name" Grid.Column="2"/>
            <TextBlock Text="Phone" Grid.Column="3"/>
            <TextBlock Text="Email" Grid.Column="4"/>
            <TextBlock Text="Address" Grid.Column="5"/>
            <TextBlock Text="ID Type" Grid.Column="6"/>
            <TextBlock Text="ID Number" Grid.Column="7"/>
            <TextBlock Text="Checked In" Grid.Column="8"/>

            <DataGrid  HeadersVisibility="None" ItemsSource="{Binding Path=Guests}" AutoGenerateColumns="False" IsReadOnly="true" Grid.ColumnSpan="9" Grid.Row="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*" Binding="{Binding GuestID}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding FirstName}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding LastName}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding PhoneNumber}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding Email}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding Address}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding IDType}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding IDNumber}"/>
                    <DataGridTextColumn Width="*" Binding="{Binding IsCheckedIn}"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.ColumnSpan="8" Grid.Row="2" Text="Total Guests: 0"/>

        </Grid>

    </Grid>

</UserControl>
