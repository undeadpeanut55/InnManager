<UserControl x:Class="InnManager.WpfApp.Controls.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InnManager.WpfApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="640" d:DesignWidth="880">
    <Grid Background="Azure">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="25"/>
            </Style>
        </Grid.Resources>
        
        <TextBlock Grid.ColumnSpan="3">Dashboard</TextBlock>
        
        <TextBlock Grid.Row="1" Background="Bisque">Total Rooms</TextBlock>
        
        <TextBlock Grid.Row="1" Grid.Column="1" Background="LightGreen">Available Rooms</TextBlock>
        
        <TextBlock Grid.Row="1" Grid.Column="2" Background="LightSalmon">Occupied Rooms</TextBlock>
        
        
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Background="Ivory">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="Recent Reservations" Grid.ColumnSpan="5"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Guest"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Room"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Check-In"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Text="Check-Out"/>
            <TextBlock Grid.Row="1" Grid.Column="4" Text="Status"/>

            
            
        </Grid>

        <Grid Grid.Column="2" Grid.Row="3">

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Background="LightBlue">Room Status</TextBlock>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Available"/>
                <TextBlock Text="Occupied"/>
                <TextBlock Text="Out of Service"/>
                <TextBlock Text="Maintenance"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
