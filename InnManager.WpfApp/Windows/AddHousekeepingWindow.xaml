<Window x:Class="InnManager.WpfApp.Windows.AddHousekeepingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InnManager.WpfApp.Windows"
        mc:Ignorable="d"
        Title="AddHousekeepingWindow" Height="450" Width="450">
    <DockPanel>
        <TextBlock Background="Azure" Text="Add new Housekeeping Task" DockPanel.Dock="Top"/>
        <WrapPanel HorizontalAlignment="Right" DockPanel.Dock="Bottom">
            <Button Click="HandleAddTaskClick" Content="Add Task"/>
            <Button Content="Cancel"/>
        </WrapPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Room"/>
                <ComboBox x:Name="RoomInput" ItemsSource="{Binding Rooms}" SelectedIndex="0"/>

                <TextBlock Text="Assigned Staff"/>
                <ComboBox x:Name="EmployeeInput" ItemsSource="{Binding Employees}" SelectedIndex="0"/>

                <TextBlock Text="Status"/>
                <ComboBox x:Name="StatusInput"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Description"/>
                <TextBox x:Name="DescriptionInput" Text="Enter task description"/>

                <TextBlock Text="Scheduled Date"/>
                <DatePicker x:Name="DateInput"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
